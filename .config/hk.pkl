// The whole hook config lives in devkit. Amend it here to override a hook or
// add a step. The base defines pre-commit, pre-push, fmt, lint, fix and check.
//
// go-workspace.pkl rather than go.pkl because this repo has a go.work: it adds
// workspace_indicator = "go.work" so hk runs golangci-lint once from the root
// rather than once per module, which collides on the golangci-lint lock.
amends "https://raw.githubusercontent.com/pmarschik/devkit/v1/hk/go-workspace.pkl"
